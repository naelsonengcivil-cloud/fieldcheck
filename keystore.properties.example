# Referência para o arquivo REAL de assinatura de release: android/keystore.properties
# (o real é gitignored — NUNCA versionar; preencher com a senha da keystore).
# Copie este arquivo para android/keystore.properties e preencha os valores.
storeFile=C:/Users/<seu-usuario>/fieldcheck-release.keystore
keyAlias=fieldcheck
storePassword=<SENHA_DA_KEYSTORE>
keyPassword=<SENHA_DA_CHAVE>
