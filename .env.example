# Copie para .env e preencha com as credenciais do projeto Supabase.
# O .env real está no .gitignore e NUNCA deve ser commitado.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Stripe (opcional) — publishable key (pública). O fluxo atual de checkout
# hospedado não a usa; só é necessária se adotarmos Stripe.js no cliente.
# A SECRET key (sk_...) NÃO vai aqui — vai nos secrets das Edge Functions.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
