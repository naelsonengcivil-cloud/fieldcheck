# Copie para .env e preencha com as credenciais do projeto Supabase.
# O .env real está no .gitignore e NUNCA deve ser commitado.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Firebase Cloud Messaging — WEB PUSH (RF12). Valores PÚBLICOS do app web do
# Firebase (Configurações do projeto → Seus apps → App da Web) + a chave VAPID
# (Cloud Messaging → Web Push certificates). Sem eles, o web push fica inativo
# e o app cai para o sino in-app. O push NATIVO (APK) não usa estes — vem do
# google-services.json embutido no build. Ver docs/push-firebase-setup.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU-PROJETO
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Stripe: o checkout é HOSPEDADO (Edge `criar-checkout` → redireciona), então
# NÃO há publishable key no front. A SECRET (sk_...) e os STRIPE_PRICE_* ficam
# nos secrets das Edge Functions, nunca aqui.
